; Declarative Workspace Harness
; Governed by hydrator.wag

workspace_harness {
    name : "s-natives" ;
    targets {
        target {
            mode : DYNAMIC ;
            engine : "go-compiler" ;
            src : "89000-internal-actors-source" ;
            out : "natvs-engine.exe" ;
            category : "ACTOR" ;
        }
    }
    promote {
        realm : PLATFORM ;
        origin : INTERNAL ;
        category : ACTOR ;
    }
}
